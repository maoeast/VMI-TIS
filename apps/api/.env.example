# ===== 交付模式 1：单机免安装版（默认 SQLite）=====
# 相对路径以 prisma/schema.prisma 所在目录（prisma/）为基准解析。
DATABASE_URL="file:../apps/api/data/vmi_tis.db"
PORT=3000
NODE_ENV=development

# 数字训练额度重置的教师授权码（缺省值 0808；生产环境务必修改）
DIGITAL_RESET_CODE=0808
# Socket.io 握手共享 token（必须与前端 VITE_SOCKET_TOKEN 一致；生产环境务必改成强随机值）
SOCKET_TOKEN=vmi-tis-dev-token
# 家庭作业视频上传目录（缺省 apps/api/data/uploads）
# UPLOADS_DIR=./data/uploads

# ===== 交付模式 2：医院服务器版（PostgreSQL）=====
# 使用时同时把 prisma/schema.prisma 的 provider 改为 "postgresql"，
# 或运行 node scripts/prepare-schema.mjs --target postgresql 生成 PostgreSQL 版 Schema。
# DATABASE_URL="postgresql://vmi:vmi2026@localhost:5432/vmi_tis"
# NODE_ENV=production
