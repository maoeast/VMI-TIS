# 构建期终端模式：all（缺省，三合一演示）/ student（学生专用）/ teacher / parent
# VITE_TERMINAL=all

# 单机版 / 浏览器开发：留空，Vite 会把 /api 与 /socket.io 代理到 localhost:3000
VITE_API_BASE=
VITE_SOCKET_URL=

# Socket.io 握手 token，必须与 API 的 SOCKET_TOKEN 一致
VITE_SOCKET_TOKEN=vmi-tis-dev-token

# Pad APK 连接医院服务器时填写（构建前设置）
# VITE_API_BASE=http://192.168.1.100:3000
# VITE_SOCKET_URL=http://192.168.1.100:3000
# 使用 HTTP 局域网 API 时，还需把该 IP 加入
# android/app/src/main/res/xml/network_security_config.xml 的 domain-config；
# 生产环境建议改用 HTTPS。
